{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline_1": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "gp_SharePointSVC"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "Wenn_ein_Element_erstellt_oder_geändert_wird": {
          "recurrence": {
            "interval": 1,
            "frequency": "Minute"
          },
          "splitOn": "@triggerOutputs()?['body/value']",
          "metadata": {
            "operationMetadataId": "251d03ac-d204-4ec2-b097-e69accc39a1b"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "https://groupsteinicke.sharepoint.com/sites/BenutzerLifecycle",
              "table": "075c1eea-3024-47cf-adb9-7a4e694b716e"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "GetOnUpdatedItems",
              "connectionName": "shared_sharepointonline_1"
            }
          }
        }
      },
      "actions": {
        "Bedingung": {
          "actions": {},
          "runAfter": {},
          "else": {
            "actions": {
              "Beenden": {
                "metadata": {
                  "operationMetadataId": "60710a2e-556b-4b5f-9ca5-578948a06fee"
                },
                "type": "Terminate",
                "inputs": {
                  "runStatus": "Succeeded"
                }
              }
            }
          },
          "expression": {
            "and": [
              {
                "equals": [
                  "@and(\n  not(equals(coalesce(triggerBody()?['TasksCreated'], false), true)),\n  contains(coalesce(triggerBody()?['LifecycleID'], ''), 'BLC-'),\n  equals(\n    coalesce(\n      triggerOutputs()?['body/RequestType/Value'],\n      triggerBody()?['RequestType']?['Value'],\n      triggerBody()?['RequestType']?['value'],\n      triggerBody()?['RequestType']\n    ),\n    'Mover'\n  ),\n  or(\n    equals(\n      coalesce(\n        triggerOutputs()?['body/LifecycleStatus/Value'],\n        triggerBody()?['LifecycleStatus']?['Value'],\n        triggerBody()?['LifecycleStatus']?['value'],\n        triggerBody()?['LifecycleStatus']\n      ),\n      'Submitted'\n    ),\n    equals(\n      coalesce(\n        triggerOutputs()?['body/LifecycleStatus/Value'],\n        triggerBody()?['LifecycleStatus']?['Value'],\n        triggerBody()?['LifecycleStatus']?['value'],\n        triggerBody()?['LifecycleStatus']\n      ),\n      'Approved'\n    )\n  )\n)",
                  "@true"
                ]
              }
            ]
          },
          "metadata": {
            "operationMetadataId": "31147e21-1d21-4a52-991f-539a336e07c7"
          },
          "type": "If"
        },
        "holeEmployee": {
          "runAfter": {
            "Compose_RelatedEmployeeID": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "1377c3cc-e5ea-473d-bb8b-ae85be7db3d3"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "https://groupsteinicke.sharepoint.com/sites/BenutzerLifecycle",
              "table": "3cd001bd-a32e-4050-8974-8817a4453e97",
              "id": "@outputs('Compose_RelatedEmployeeID')"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "GetItem",
              "connectionName": "shared_sharepointonline_1"
            }
          }
        },
        "holeEmployeeRoles": {
          "runAfter": {
            "holeEmployee": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "https://groupsteinicke.sharepoint.com/sites/BenutzerLifecycle",
              "table": "7f0c6aa9-ac6e-4af2-ace8-690324c22586",
              "$filter": "EmployeeId eq @{outputs('Compose_RelatedEmployeeID')} and Active eq 1 and IsPrimaryRole eq 1",
              "$top": 1
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "GetItems",
              "connectionName": "shared_sharepointonline_1"
            }
          }
        },
        "Compose_OldRoleProfileId": {
          "runAfter": {
            "holeEmployeeRoles": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@\ncoalesce(\n  first(body('holeEmployeeRoles')?['value'])?['RoleProfile']?['Id'],\n  first(body('holeEmployeeRoles')?['value'])?['RoleProfile#Id'],\n  outputs('holeEmployee')?['body/RoleProfile']?['Id'],\n  outputs('holeEmployee')?['body/RoleProfile#Id']\n)\n"
        },
        "Compose_NewRoleProfileId": {
          "runAfter": {
            "Compose_OldRoleProfileId": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@triggerBody()?['RoleProfile/Id']"
        },
        "Compose_CurrentEmployeeRoleItemId": {
          "runAfter": {
            "Compose_NewRoleProfileId": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@first(body('holeEmployeeRoles')?['value'])?['ID']"
        },
        "Compose_RoleChangeRequired": {
          "runAfter": {
            "Compose_CurrentEmployeeRoleItemId": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@and(\n  greater(int(coalesce(outputs('Compose_OldRoleProfileId'), 0)), 0),\n  greater(int(coalesce(outputs('Compose_NewRoleProfileId'), 0)), 0),\n  not(\n    equals(\n      string(outputs('Compose_OldRoleProfileId')),\n      string(outputs('Compose_NewRoleProfileId'))\n    )\n  )\n)"
        },
        "Compose_NewDisplayName": {
          "runAfter": {
            "Compose_RoleChangeRequired": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@\ncoalesce(\n  triggerBody()?['RequestedDisplayName'],\n  outputs('holeEmployee')?['body/DisplayName']\n)\n"
        },
        "Compose_NewUPN": {
          "runAfter": {
            "Compose_NewDisplayName": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@\ncoalesce(\n  triggerBody()?['RequestedUPN'],\n  outputs('holeEmployee')?['body/UPN']\n)\n"
        },
        "Compose_NewEmail": {
          "runAfter": {
            "Compose_NewUPN": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@\ncoalesce(\n  triggerBody()?['RequestedEmail'],\n  outputs('holeEmployee')?['body/Email']\n)\n"
        },
        "Compose_NewPhoneNumber": {
          "runAfter": {
            "Compose_NewEmail": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@\ncoalesce(\n  triggerBody()?['RequestedPhoneNumber'],\n  outputs('holeEmployee')?['body/PhoneNumber']\n)\n"
        },
        "Compose_IdentityChangeRequired": {
          "runAfter": {
            "Compose_NewPhoneNumber": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@or(\n  not(equals(\n    toLower(coalesce(outputs('holeEmployee')?['body/DisplayName'], '')),\n    toLower(coalesce(outputs('Compose_NewDisplayName'), ''))\n  )),\n  not(equals(\n    toLower(coalesce(outputs('holeEmployee')?['body/UPN'], '')),\n    toLower(coalesce(outputs('Compose_NewUPN'), ''))\n  )),\n  not(equals(\n    toLower(coalesce(outputs('holeEmployee')?['body/Email'], '')),\n    toLower(coalesce(outputs('Compose_NewEmail'), ''))\n  )),\n  not(equals(\n    coalesce(outputs('holeEmployee')?['body/PhoneNumber'], ''),\n    coalesce(outputs('Compose_NewPhoneNumber'), '')\n  ))\n)"
        },
        "Condition_RoleChangeRequired": {
          "actions": {
            "Get_items_OldRoleEntitlements": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "https://groupsteinicke.sharepoint.com/sites/BenutzerLifecycle",
                  "table": "39f57149-d82c-415b-85c8-d06399265ba1",
                  "$filter": "RoleProfileId eq @{outputs('Compose_OldRoleProfileId')} and Active eq 1 and RequiredForMover eq 1"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "GetItems",
                  "connectionName": "shared_sharepointonline_1"
                }
              }
            },
            "Get_items_NewRoleEntitlements": {
              "runAfter": {
                "Get_items_OldRoleEntitlements": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "https://groupsteinicke.sharepoint.com/sites/BenutzerLifecycle",
                  "table": "39f57149-d82c-415b-85c8-d06399265ba1",
                  "$filter": "RoleProfileId eq @{outputs('Compose_NewRoleProfileId')} and Active eq 1 and RequiredForMover eq 1"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "GetItems",
                  "connectionName": "shared_sharepointonline_1"
                }
              }
            },
            "Apply_to_each_NewRoleEntitlement": {
              "foreach": "@outputs('Get_items_NewRoleEntitlements')?['body/value']",
              "actions": {
                "Get_items_OldMatchingEntitlement": {
                  "runAfter": {
                    "_Compose_CurrentEntitlementId": [
                      "Succeeded"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "dataset": "https://groupsteinicke.sharepoint.com/sites/BenutzerLifecycle",
                      "table": "39f57149-d82c-415b-85c8-d06399265ba1",
                      "$filter": "RoleProfileId eq @{outputs('Compose_OldRoleProfileId')} and EntitlementId eq @{outputs('_Compose_CurrentEntitlementId')} and Active eq 1 and RequiredForMover eq 1",
                      "$top": 1
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "operationId": "GetItems",
                      "connectionName": "shared_sharepointonline_1"
                    }
                  }
                },
                "New_Entitlement": {
                  "actions": {
                    "Get_item_AddEntitlement": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "parameters": {
                          "dataset": "https://groupsteinicke.sharepoint.com/sites/BenutzerLifecycle",
                          "table": "f78463dd-8915-4d19-a44d-ef125cfa0200",
                          "id": "@outputs('_Compose_CurrentEntitlementId')"
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "operationId": "GetItem",
                          "connectionName": "shared_sharepointonline_1"
                        }
                      }
                    },
                    "Compose_AddTaskTitle": {
                      "runAfter": {
                        "Get_item_AddEntitlement": [
                          "Succeeded"
                        ]
                      },
                      "type": "Compose",
                      "inputs": "@\nconcat(\n  'Recht erteilen: ',\n  outputs('Get_item_AddEntitlement')?['body/Title']\n)\n"
                    },
                    "Compose_AddTaskDescription": {
                      "runAfter": {
                        "Compose_AddTaskTitle": [
                          "Succeeded"
                        ]
                      },
                      "type": "Compose",
                      "inputs": "@\ncoalesce(\n  items('Apply_to_each_NewRoleEntitlement')?['TaskDescriptionOverride_Mover'],\n  outputs('Get_item_AddEntitlement')?['body/TaskDescription_Mover'],\n  concat(\n    'Recht zuweisen wegen Rollenwechsel.',\n    decodeUriComponent('%0A'),\n    'Mitarbeiter: ', outputs('holeEmployee')?['body/DisplayName'],\n    decodeUriComponent('%0A'),\n    'LifecycleID: ', triggerBody()?['LifecycleID']\n  )\n)\n"
                    },
                    "Compose_AddTaskID": {
                      "runAfter": {
                        "Compose_AddTaskDescription": [
                          "Succeeded"
                        ]
                      },
                      "type": "Compose",
                      "inputs": "@\nconcat(\n  triggerBody()?['LifecycleID'],\n  '-ADD-',\n  outputs('Get_item_AddEntitlement')?['body/EntitlementID']\n)\n"
                    },
                    "GetExistingAddTask": {
                      "runAfter": {
                        "Compose_AddTaskID": [
                          "Succeeded"
                        ]
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "parameters": {
                          "dataset": "https://groupsteinicke.sharepoint.com/sites/BenutzerLifecycle",
                          "table": "7e2e0b98-00c4-436b-abbb-6495d56d79a3",
                          "$filter": "TaskID eq '@{outputs('Compose_AddTaskID')}'",
                          "$top": 1
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "operationId": "GetItems",
                          "connectionName": "shared_sharepointonline_1"
                        }
                      }
                    },
                    "TaskIsNew": {
                      "actions": {
                        "Create_item_AddTask": {
                          "type": "OpenApiConnection",
                          "inputs": {
                            "parameters": {
                              "dataset": "https://groupsteinicke.sharepoint.com/sites/BenutzerLifecycle",
                              "table": "7e2e0b98-00c4-436b-abbb-6495d56d79a3",
                              "item/Title": "@concat(triggerBody()?['LifecycleID'], ' - ADD - ', outputs('Get_item_AddEntitlement')?['body/Title'])",
                              "item/TaskTitle": "@\nconcat(\n  triggerBody()?['LifecycleID'],\n  ' - ',\n  outputs('holeEmployee')?['body/DisplayName'],\n  ' - ADD - ',\n  outputs('Get_item_AddEntitlement')?['body/Title']\n)\n",
                              "item/TaskID": "@outputs('Compose_AddTaskID')",
                              "item/TaskOwnerGroup/Value": "@outputs('Get_item_AddEntitlement')?['body/TaskOwnerGroup_Mover/Value']",
                              "item/TaskStatus/Value": "Open",
                              "item/RelatedLifecycleRequest/Id": "@triggerBody()?['ID']",
                              "item/TaskDescription": "@outputs('Compose_AddTaskDescription')",
                              "item/Priority/Value": "Normal",
                              "item/RequiresEvidence": "@coalesce(outputs('Get_item_AddEntitlement')?['body/RequiresEvidence_Mover'], false)",
                              "item/EvidenceDescription": "@coalesce(outputs('Get_item_AddEntitlement')?['body/EvidenceDescription_Mover'], '')",
                              "item/RelatedEmployee/Id": "@outputs('Compose_RelatedEmployeeID')",
                              "item/RelatedEntitlement/Id": "@outputs('_Compose_CurrentEntitlementId')",
                              "item/LifecycleID": "@triggerBody()?['LifecycleID']"
                            },
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                              "operationId": "PostItem",
                              "connectionName": "shared_sharepointonline_1"
                            }
                          }
                        }
                      },
                      "runAfter": {
                        "GetExistingAddTask": [
                          "Succeeded"
                        ]
                      },
                      "else": {
                        "actions": {}
                      },
                      "expression": {
                        "and": [
                          {
                            "equals": [
                              "@length(body('GetExistingAddTask')?['value'])",
                              0
                            ]
                          }
                        ]
                      },
                      "type": "If"
                    }
                  },
                  "runAfter": {
                    "Get_items_OldMatchingEntitlement": [
                      "Succeeded"
                    ]
                  },
                  "else": {
                    "actions": {}
                  },
                  "expression": {
                    "and": [
                      {
                        "equals": [
                          "@length(body('Get_items_OldMatchingEntitlement')?['value'])",
                          0
                        ]
                      }
                    ]
                  },
                  "type": "If"
                },
                "_Compose_CurrentEntitlementId": {
                  "type": "Compose",
                  "inputs": "@\ncoalesce(\n  items('Apply_to_each_NewRoleEntitlement')?['Entitlement']?['Id'],\n  items('Apply_to_each_NewRoleEntitlement')?['Entitlement#Id'],\n  items('Apply_to_each_NewRoleEntitlement')?['EntitlementId']\n)\n"
                }
              },
              "runAfter": {
                "Get_items_NewRoleEntitlements": [
                  "Succeeded"
                ]
              },
              "type": "Foreach"
            },
            "Apply_to_each_OldRoleEntitlement": {
              "foreach": "@outputs('Get_items_OldRoleEntitlements')?['body/value']",
              "actions": {
                "Get_items_NewMatchingEntitlement": {
                  "runAfter": {
                    "Compose_CurrentOldEntitlementId": [
                      "Succeeded"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "dataset": "https://groupsteinicke.sharepoint.com/sites/BenutzerLifecycle",
                      "table": "39f57149-d82c-415b-85c8-d06399265ba1",
                      "$filter": "RoleProfileId eq @{outputs('Compose_NewRoleProfileId')} and EntitlementId eq @{outputs('Compose_CurrentOldEntitlementId')} and Active eq 1 and RequiredForMover eq 1",
                      "$top": 1
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "operationId": "GetItems",
                      "connectionName": "shared_sharepointonline_1"
                    }
                  }
                },
                "Old_Entitlement_Obsolete": {
                  "actions": {
                    "Get_item_RemoveEntitlement": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "parameters": {
                          "dataset": "https://groupsteinicke.sharepoint.com/sites/BenutzerLifecycle",
                          "table": "f78463dd-8915-4d19-a44d-ef125cfa0200",
                          "id": "@outputs('Compose_CurrentOldEntitlementId')"
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "operationId": "GetItem",
                          "connectionName": "shared_sharepointonline_1"
                        }
                      }
                    },
                    "Compose_RemoveTaskTitle": {
                      "runAfter": {
                        "Get_item_RemoveEntitlement": [
                          "Succeeded"
                        ]
                      },
                      "type": "Compose",
                      "inputs": "@\nconcat(\n  'Recht entfernen: ',\n  outputs('Get_item_RemoveEntitlement')?['body/Title']\n)\n"
                    },
                    "Compose_RemoveTaskDescription": {
                      "runAfter": {
                        "Compose_RemoveTaskTitle": [
                          "Succeeded"
                        ]
                      },
                      "type": "Compose",
                      "inputs": "@\ncoalesce(\n  items('Apply_to_each_OldRoleEntitlement')?['TaskDescriptionOverride_Mover'],\n  outputs('Get_item_RemoveEntitlement')?['body/TaskDescription_Mover'],\n  concat(\n    'Entferne Recht wegen Rollenwechsel.',\n    decodeUriComponent('%0A'),\n    'Mitarbeiter: ', outputs('holeEmployee')?['body/DisplayName'],\n    decodeUriComponent('%0A'),\n    'LifecycleID: ', triggerBody()?['LifecycleID']\n  )\n)\n"
                    },
                    "Compose_RemoveTaskID": {
                      "runAfter": {
                        "Compose_RemoveTaskDescription": [
                          "Succeeded"
                        ]
                      },
                      "type": "Compose",
                      "inputs": "@\nconcat(\n  triggerBody()?['LifecycleID'],\n  '-REMOVE-',\n  outputs('Get_item_RemoveEntitlement')?['body/EntitlementID']\n)\n"
                    },
                    "GetExistingRemoveTask": {
                      "runAfter": {
                        "Compose_RemoveTaskID": [
                          "Succeeded"
                        ]
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "parameters": {
                          "dataset": "https://groupsteinicke.sharepoint.com/sites/BenutzerLifecycle",
                          "table": "7e2e0b98-00c4-436b-abbb-6495d56d79a3",
                          "$filter": "TaskID eq '@{outputs('Compose_RemoveTaskID')}'",
                          "$top": 1
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "operationId": "GetItems",
                          "connectionName": "shared_sharepointonline_1"
                        }
                      }
                    },
                    "RemoveTaskIsNew": {
                      "actions": {
                        "Create_item_RemoveTask": {
                          "type": "OpenApiConnection",
                          "inputs": {
                            "parameters": {
                              "dataset": "https://groupsteinicke.sharepoint.com/sites/BenutzerLifecycle",
                              "table": "7e2e0b98-00c4-436b-abbb-6495d56d79a3",
                              "item/Title": "@concat(triggerBody()?['LifecycleID'], ' - REMOVE - ', outputs('Get_item_RemoveEntitlement')?['body/Title'])",
                              "item/TaskTitle": "@\nconcat(\n  triggerBody()?['LifecycleID'],\n  ' - ',\n  outputs('holeEmployee')?['body/DisplayName'],\n  ' - REMOVE - ',\n  outputs('Get_item_RemoveEntitlement')?['body/Title']\n)\n",
                              "item/TaskID": "@outputs('Compose_RemoveTaskID')",
                              "item/TaskCategory/Value": "@outputs('Get_item_RemoveEntitlement')?['body/TaskOwnerGroup_Mover/Value']",
                              "item/TaskOwnerGroup/Value": "@outputs('Get_item_RemoveEntitlement')?['body/TaskOwnerGroup_Mover/Value']",
                              "item/TaskStatus/Value": "Open",
                              "item/RelatedLifecycleRequest/Id": "@triggerBody()?['ID']",
                              "item/TaskDescription": "@outputs('Compose_RemoveTaskDescription')",
                              "item/RequiresEvidence": "@coalesce(outputs('Get_item_RemoveEntitlement')?['body/RequiresEvidence_Mover'], false)",
                              "item/EvidenceDescription": "@coalesce(outputs('Get_item_RemoveEntitlement')?['body/EvidenceDescription_Mover'], '')",
                              "item/RelatedEmployee/Id": "@outputs('Compose_RelatedEmployeeID')",
                              "item/RelatedEntitlement/Id": "@outputs('Compose_CurrentOldEntitlementId')",
                              "item/LifecycleID": "@triggerBody()?['LifecycleID']"
                            },
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                              "operationId": "PostItem",
                              "connectionName": "shared_sharepointonline_1"
                            }
                          }
                        }
                      },
                      "runAfter": {
                        "GetExistingRemoveTask": [
                          "Succeeded"
                        ]
                      },
                      "else": {
                        "actions": {}
                      },
                      "expression": {
                        "and": [
                          {
                            "equals": [
                              "@length(body('GetExistingRemoveTask')?['value'])",
                              0
                            ]
                          }
                        ]
                      },
                      "type": "If"
                    }
                  },
                  "runAfter": {
                    "Get_items_NewMatchingEntitlement": [
                      "Succeeded"
                    ]
                  },
                  "else": {
                    "actions": {}
                  },
                  "expression": {
                    "and": [
                      {
                        "equals": [
                          "@length(body('Get_items_NewMatchingEntitlement')?['value'])",
                          0
                        ]
                      }
                    ]
                  },
                  "type": "If"
                },
                "Compose_CurrentOldEntitlementId": {
                  "type": "Compose",
                  "inputs": "@\ncoalesce(\n  items('Apply_to_each_OldRoleEntitlement')?['Entitlement']?['Id'],\n  items('Apply_to_each_OldRoleEntitlement')?['Entitlement#Id'],\n  items('Apply_to_each_OldRoleEntitlement')?['EntitlementId']\n)\n"
                }
              },
              "runAfter": {
                "Apply_to_each_NewRoleEntitlement": [
                  "Succeeded"
                ]
              },
              "type": "Foreach"
            }
          },
          "runAfter": {
            "Compose_IdentityChangeRequired": [
              "Succeeded"
            ]
          },
          "else": {
            "actions": {}
          },
          "expression": {
            "and": [
              {
                "equals": [
                  "@outputs('Compose_RoleChangeRequired')",
                  true
                ]
              }
            ]
          },
          "type": "If"
        },
        "Condition_IdentityChangeRequired": {
          "actions": {
            "Identity_Task_DisplayName": {
              "actions": {
                "Create_Item_IentityTask_DisplayName": {
                  "type": "OpenApiConnection",
                  "inputs": {
